      },
      {
        "name": "NSLocationAlwaysAndWhenInUseUsageDescription",
        "value": "Location access is required to support location-based app features."
      },
      {
        "name": "NSPhotoLibraryAddUsageDescription",
        "value": "Photo library access is required to upload photos or videos."
      },
      {
        "name": "NSPhotoLibraryUsageDescription",
        "value": "Photo library access is required to upload photos or videos."
      },
      {
        "name": "NSMicrophoneUsageDescription",
        "value": "Microphone access is required for voice recording features."
      },
      {
        "name": "AllowInlineMediaPlayback",
        "value": "true"
      },
      {
        "name": "NSAllowsArbitraryLoads",
        "value": "false"
