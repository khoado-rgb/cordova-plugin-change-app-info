{
  "plugin": {
    "url": "https://github.com/khoado-rgb/cordova-plugin-change-app-info.git#test/mabs12-build"
  },
  "preferences": {
    "global": [
      {
        "name": "orientation",
        "value": "portrait"
      },
      {
        "name": "APP_NAME",
        "value": "My App"
      },
      {
        "name": "CDN_ICON",
        "value": "https://cdn.example.com/assets/app/icon.png"
      },
      {
        "name": "CDN_RESOURCE",
        "value": "https://cdn.example.com/assets/app/app.css"
      },
      {
        "name": "APP_DISTRIBUTION_API",
        "value": "https://api.example.com/app-distribution"
      },
      {
        "name": "APP_DISTRIBUTION_BEARER_TOKEN",
        "value": "REPLACE_WITH_APP_DISTRIBUTION_BEARER_TOKEN"
